{
  "expo": {
    "name": "ONCOSMART",
    "slug": "oncofitness-app",
    "scheme": "oncofitness",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oncosmart.oncofitness"
    },
    "android": {
      "package": "com.oncosmart.oncofitness",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4ee18dcf-2b0d-455f-b07f-17c368ca8e61"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-localization",
      "expo-video",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#005F99",
          "defaultChannel": "exercise-reminders"
        }
      ],
      "expo-asset",
      "expo-updates"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ee18dcf-2b0d-455f-b07f-17c368ca8e61"
      }
    },
    "owner": "sudarvel1234s-team"
  }
}
